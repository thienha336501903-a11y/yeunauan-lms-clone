# Clone identity (public, non-secret)
SYSTEM_ID=system-b
SYSTEM_NAME=YeuBep
COMMERCE_PUBLIC_URL=https://yeubep.shop
LMS_PUBLIC_URL=https://hoc.yeubep.shop
V4_PUBLIC_URL=https://v4.daubepnho.store
TELEGRAM_CLONER_URL=https://reader.yeubep.shop
LEGACY_POST_PUBLIC_URL=https://yeunauan.live

# Database (server-only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-project-specific-server-key

# Shared only between services belonging to this clone
INTERNAL_SYNC_SECRET=generate-a-long-random-clone-only-secret

# Authentication and administration
SESSION_SECRET=generate-at-least-32-random-bytes
ADMIN_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_EMAIL=replace-me@replace-me.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=replace-me

# Student session guard
# Temporary default: allow a new portal device to take over the active student session.
# Set true to restore the previous cross-device 409 block.
STUDENT_SINGLE_DEVICE_BLOCK_ENABLED=false

# Optional integrations
TELEGRAM_MEDIA_GATEWAY_URL=https://reader.yeubep.shop/api/telegram/media
TELEGRAM_THUMBNAIL_GATEWAY_URL=https://reader.yeubep.shop/api/telegram/thumbnail
TELEGRAM_MTPROTO_GATEWAY_URL=https://reader.yeubep.shop/api/telegram/warmup
TELEGRAM_CLONER_HEALTH_URL=https://reader.yeubep.shop/api/health
BUNNY_STREAM_TOKEN_KEY=replace-me
