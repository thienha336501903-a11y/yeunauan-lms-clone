{
  "regions": ["sin1"],
  "redirects": [
    { "source": "/", "destination": "https://hoc.yeubep.shop/my-courses.html", "permanent": false },
    { "source": "/my-courses", "destination": "https://hoc.yeubep.shop/my-courses.html", "permanent": false },
    { "source": "/post/:id", "destination": "https://yeunauan.live/post/:id", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/lms/portal?endpoint=health" },
    { "source": "/learning", "destination": "/api/learning" },
    { "source": "/v3", "destination": "/v3-entry.html" },
    { "source": "/v3-admin", "destination": "/channel-admin-candidate.html" },
    { "source": "/v4-poc", "destination": "/v4-poc.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
