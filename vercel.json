{
  "regions": ["sin1"],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": "https://yeunauan-commerce-clone\\.vercel\\.app(?:/.*)?"
        }
      ],
      "destination": "/my-courses.html?registered=1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/learning", "destination": "/api/learning" },
    { "source": "/v3", "destination": "/v3-entry.html" },
    { "source": "/v3-admin", "destination": "/channel-admin-candidate.html" },
    { "source": "/v4-poc", "destination": "/v4-poc.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
