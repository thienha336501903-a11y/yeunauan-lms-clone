name = "yeubep-v5-media"
main = "src/index.js"
compatibility_date = "2026-08-01"

# Copy to wrangler.toml locally or configure in Cloudflare Dashboard.
# Do not commit secrets.

[[r2_buckets]]
binding = "V5_MEDIA"
bucket_name = "yeubep-v5-media-prod"

# Per authenticated student/video, per Cloudflare location. The Worker calls
# this binding only after a playback lease passes signature, TTL and UA checks.
[[ratelimits]]
name = "V5_MEDIA_RATE_LIMITER"
namespace_id = "1001"

  [ratelimits.simple]
  limit = 600
  period = 60

# V2 nonce replay protection is strongly consistent per student/video shard.
[[durable_objects.bindings]]
name = "V5_PLAYBACK_NONCES"
class_name = "V5PlaybackNonceGuard"

[[migrations]]
tag = "v5-playback-v2-nonces"
new_sqlite_classes = ["V5PlaybackNonceGuard"]

[vars]
# Comma-separated exact origins.
# Keep only exact trusted Preview aliases while V5 is being tested; do not use wildcards.
V5_ALLOWED_ORIGINS = "https://v5.daubepnho.store,https://v4.daubepnho.store,https://hoc.yeubep.shop,https://yeunauan-lms-v4-test-git-bb43d1-thienha336501903-a11ys-projects.vercel.app,https://yeunauan-lms-git-d4dd8d-thienha100022653824678-stacks-projects.vercel.app"
V5_MEDIA_RATE_LIMIT_RETRY_AFTER_SECONDS = "60"

# Secret required at runtime (set with `wrangler secret put`, not here):
# V5_PLAYBACK_PUBLIC_JWK={...public EC P-256 JWK...}
# Optional second key for zero-downtime Preview rotation. Keep the legacy key
# until every existing lease issuer has moved to the replacement key.
# V5_PLAYBACK_PUBLIC_JWK_PREVIEW={...public EC P-256 JWK...}
