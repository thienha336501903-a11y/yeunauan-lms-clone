name = "yeubep-v5-media"
main = "src/index.js"
compatibility_date = "2026-08-01"

# Copy to wrangler.toml locally or configure in Cloudflare Dashboard.
# Do not commit secrets.

[[r2_buckets]]
binding = "V5_MEDIA"
bucket_name = "yeubep-v5-media-prod"

[vars]
# Comma-separated exact origins. Add Preview origins only while testing.
V5_ALLOWED_ORIGINS = "https://v5.daubepnho.store,https://v4.daubepnho.store,https://hoc.yeubep.shop"

# Secret required at runtime (set with `wrangler secret put`, not here):
# V5_PLAYBACK_PUBLIC_JWK={...public EC P-256 JWK...}
