{
"name": "landing-page",
"version": "1.0.0",
"type": "module",
"scripts": {
"test": "node --test",
"check:domains": "node scripts/check-domain-isolation.js",
"check:secrets": "! git grep -nE '(sb_secret_[A-Za-z0-9_-]{20,}|service_role.{0,20}[A-Za-z0-9_-]{24,}|[0-9]{8,}:[A-Za-z0-9_-]{30,})' -- ':!package.json' ':!package-lock.json' ':!scripts/check-domain-isolation.js' ':!.github/workflows/*'",
"check:clone": "npm run check:domains && npm run check:secrets"
},
"dependencies": {
"@supabase/supabase-js": "^2.39.8",
"cloudinary": "^2.3.0",
"google-auth-library": "^11.0.2",
"googleapis": "^176.0.0"
}
}
